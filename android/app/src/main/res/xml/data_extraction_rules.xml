<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the same rule for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="library/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="library/" />
    </device-transfer>
</data-extraction-rules>
